# nginx site for the Docker image. The nginx image renders this into
# /etc/nginx/conf.d/default.conf at startup, substituting ${API_UPSTREAM} only
# (NGINX_ENVSUBST_FILTER in the Dockerfile).
#
# Static behaviour matches deploy/linux/nginx.conf and deploy/iis/web.config:
# SPA fallback, config.js and index.html never cached, hashed build assets
# cached for a year.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml font/woff font/woff2;
  gzip_min_length 1024;

  add_header X-Content-Type-Options "nosniff" always;

  # A location with its own add_header drops the server-level ones, so each
  # repeats nosniff.

  # Hashed build assets (nuxt.config.ts: buildAssetsDir 'assets/') are immutable.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # Per-deployment config and the shell must never be cached.
  location = /config.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header X-Content-Type-Options "nosniff" always;
  }

  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header X-Content-Type-Options "nosniff" always;
  }

  # Backend proxy. The .NET 8 backend mounts everything under /service/ (its
  # MANGO_PATH_BASE default), and the URI is forwarded unchanged. With
  # DATA_SERVER=/service/ the browser calls this origin, so the backend's CORS
  # list does not need to include the container's port. Auth travels in the
  # X-Mango-Auth request header, which nginx passes through.
  #
  # nginx resolves API_UPSTREAM's host when it starts and exits if it cannot;
  # compose maps host.docker.internal for Linux hosts too. If the backend is
  # simply not running, only /service/ fails (502) — the site still loads.
  location /service/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SignalR: websockets and long polling.
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_buffering off;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
